#!/usr/bin/env bash
#
# scan-download  -  layered security scan for downloaded / cloned source trees
#
# Usage:
#   scan-download [PATH]          # scan PATH (default: current directory)
#   scan-download --quick [PATH]  # skip the slower SAST (semgrep) pass
#
# Layers:
#   1. MALWARE / supply-chain  (guarddog)   - the "recent attacks" layer
#   2. KNOWN VULNS + SECRETS   (trivy, osv-scanner, pip-audit)
#   3. INSECURE CODE PATTERNS  (semgrep)    - SAST on the source itself
#   4. OPTIONAL behavioral     (socket)     - only if installed AND logged in
#
# Exit code: 0 = nothing flagged, 1 = at least one tool reported findings,
#            2 = usage / setup error.
#
# A full combined log is written to:  <PATH>/.scan-reports/scan-<timestamp>.log
#
set -uo pipefail

# ---- args ----------------------------------------------------------------
QUICK=0
TARGET="."
for a in "$@"; do
  case "$a" in
    --quick) QUICK=1 ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) TARGET="$a" ;;
  esac
done

# The scanners are Linux/macOS tools. Git Bash on Windows would report every
# one as missing, so stop early and point at WSL instead.
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*|CYGWIN*)
    echo "scan-download: native Windows shell detected; the scanners run in WSL." >&2
    echo "  Run: wsl.exe -e bash -lc 'bash /mnt/<drive>/<path-to>/scan-download /mnt/<drive>/<target>'" >&2
    exit 2 ;;
esac

if [ ! -d "$TARGET" ]; then
  echo "scan-download: '$TARGET' is not a directory" >&2
  exit 2
fi
TARGET="$(cd "$TARGET" && pwd)"   # absolutize

TS="$(date +%Y-%m-%d_%H%M%S)"
REPORTDIR="$TARGET/.scan-reports"
mkdir -p "$REPORTDIR"
LOG="$REPORTDIR/scan-$TS.log"

# ---- pretty + logging helpers --------------------------------------------
c_hdr=$'\033[1;36m'; c_ok=$'\033[1;32m'; c_warn=$'\033[1;33m'; c_bad=$'\033[1;31m'; c_off=$'\033[0m'
# tool -> CLEAN | FINDINGS | SKIP(reason). macOS ships bash 3.2, which has no
# associative arrays, so keep two parallel indexed arrays.
RESULT_KEYS=(); RESULT_VALS=()
set_result() {  # set_result <key> <value>
  local i=0
  while [ "$i" -lt "${#RESULT_KEYS[@]}" ]; do
    if [ "${RESULT_KEYS[$i]}" = "$1" ]; then RESULT_VALS[$i]="$2"; return; fi
    i=$((i + 1))
  done
  RESULT_KEYS+=("$1"); RESULT_VALS+=("$2")
}
get_result() {  # get_result <key> : prints the value, or nothing if unset
  local i=0
  while [ "$i" -lt "${#RESULT_KEYS[@]}" ]; do
    if [ "${RESULT_KEYS[$i]}" = "$1" ]; then printf '%s' "${RESULT_VALS[$i]}"; return; fi
    i=$((i + 1))
  done
}

section() { printf '\n%s========== %s ==========%s\n' "$c_hdr" "$1" "$c_off" | tee -a "$LOG"; }
have()    { command -v "$1" >/dev/null 2>&1; }

# with_timeout <secs> <cmd...> : GNU `timeout` semantics (exit 124 on timeout).
# macOS has no `timeout`; Homebrew coreutils installs it as `gtimeout`. Without
# either, a background watchdog kills the command and its children.
with_timeout() {
  local secs="$1"; shift
  if have timeout;  then timeout  "${secs}s" "$@"; return; fi
  if have gtimeout; then gtimeout "${secs}s" "$@"; return; fi
  local marker pid watcher rc
  marker="$(mktemp "${TMPDIR:-/tmp}/scan-download-timeout.XXXXXX")"; rm -f "$marker"
  "$@" & pid=$!
  ( sleep "$secs"
    if kill -0 "$pid" 2>/dev/null; then
      : >"$marker"; pkill -TERM -P "$pid" 2>/dev/null; kill -TERM "$pid" 2>/dev/null
    fi ) &
  watcher=$!
  # A background job ignores SIGINT, so Ctrl-C must be forwarded by hand.
  trap 'pkill -TERM -P "$pid" 2>/dev/null; kill -TERM "$pid" 2>/dev/null
        pkill -P "$watcher" 2>/dev/null; kill "$watcher" 2>/dev/null
        rm -f "$marker"; exit 130' INT TERM
  wait "$pid"; rc=$?
  trap - INT TERM
  pkill -P "$watcher" 2>/dev/null; kill "$watcher" 2>/dev/null; wait "$watcher" 2>/dev/null
  if [ -e "$marker" ]; then rm -f "$marker"; return 124; fi
  return "$rc"
}

# run <label> <toolkey> <cmd...>  : tee output to log, record result by exit code
run() {
  local label="$1" key="$2"; shift 2
  printf '\n--- %s ---\n' "$label" >>"$LOG"
  printf '$ %s\n' "$*" >>"$LOG"
  if "$@" >>"$LOG" 2>&1; then
    set_result "$key" CLEAN;    printf '  %s%s: clean%s\n' "$c_ok" "$label" "$c_off"
  else
    set_result "$key" FINDINGS; printf '  %s%s: FINDINGS (see log)%s\n' "$c_bad" "$label" "$c_off"
  fi
}
skip() { set_result "$1" "SKIP: $2"; printf '  %s%s: skipped (%s)%s\n' "$c_warn" "$1" "$2" "$c_off"; }

# guarddog exits 0 even when it prints malware indicators, so exit-code scoring
# (run) would silently mark the MALWARE layer "clean". Parse its output instead.
# run_guarddog <label> <key> <ecosystem>
run_guarddog() {
  local label="$1" key="$2" eco="$3" out n suppressed net
  local ALLOWLIST="${SCAN_ALLOWLIST:-$HOME/.config/scan-download/guarddog-allow.txt}"
  printf '\n--- %s ---\n' "$label" >>"$LOG"
  printf '$ guarddog %s scan %s\n' "$eco" "$TARGET" >>"$LOG"
  out="$(guarddog "$eco" scan "$TARGET" 2>&1)"
  printf '%s\n' "$out" >>"$LOG"
  # guarddog's "Found N ..." is the authoritative total indicator count.
  n="$(printf '%s' "$out" | grep -oiE "Found [0-9]+ potentially malicious" | grep -oE "[0-9]+" | head -1)"
  n="${n:-0}"
  # Allowlist: suppress indicator bullets whose block contains any allowlisted
  # substring (one per line in $ALLOWLIST; '#' comments + blanks ignored).
  suppressed=0
  if [ "$n" -gt 0 ] && [ -s "$ALLOWLIST" ]; then
    suppressed="$(printf '%s\n' "$out" | awk -v alf="$ALLOWLIST" '
      BEGIN{ np=0; while((getline p < alf)>0){ if(p ~ /[^[:space:]]/ && p !~ /^[[:space:]]*#/) pat[++np]=p } }
      function flush(){ if(blk==""){return}; for(i=1;i<=np;i++){ if(index(blk,pat[i])){ s++; break } }; blk="" }
      /^[[:space:]]*\* This package/{ flush(); blk=$0; next }
      { if(blk!="") blk=blk "\n" $0 }
      END{ flush(); print s+0 }')"
    suppressed="${suppressed:-0}"
    [ "$suppressed" -gt 0 ] && printf '  (allowlist suppressed %s known-benign indicator(s))\n' "$suppressed" >>"$LOG"
  fi
  net=$(( n - suppressed )); [ "$net" -lt 0 ] && net=0
  if [ "$net" -gt 0 ]; then
    set_result "$key" FINDINGS
    printf '  %s%s: %s INDICATOR(S) — REVIEW the log (heuristic; often benign)%s\n' "$c_bad" "$label" "$net" "$c_off"
  elif [ "$suppressed" -gt 0 ]; then
    set_result "$key" CLEAN
    printf '  %s%s: clean (%s allowlisted)%s\n' "$c_ok" "$label" "$suppressed" "$c_off"
  else
    set_result "$key" CLEAN
    printf '  %s%s: clean%s\n' "$c_ok" "$label" "$c_off"
  fi
}

echo "scan-download  target: $TARGET" | tee "$LOG"
echo "started: $(date '+%Y-%m-%d %H:%M:%S')" | tee -a "$LOG"

# detect ecosystems present
has_py=0; has_js=0
if find "$TARGET" -maxdepth 3 \( -name '*.py' -o -name 'requirements*.txt' -o -name pyproject.toml -o -name setup.py \) -print -quit | grep -q .; then has_py=1; fi
if find "$TARGET" -maxdepth 3 \( -name package.json -o -name package-lock.json -o -name yarn.lock \) -print -quit | grep -q .; then has_js=1; fi

# =========================================================================
section "LAYER 1  MALWARE / SUPPLY-CHAIN  (guarddog)"
# =========================================================================
if have guarddog; then
  [ "$has_py" = 1 ] && run_guarddog "guarddog/pypi" gd_py pypi
  [ "$has_js" = 1 ] && run_guarddog "guarddog/npm"  gd_js npm
  [ "$has_py" = 0 ] && [ "$has_js" = 0 ] && skip "guarddog" "no python/npm package detected"
else
  skip "guarddog" "not installed - run install-security-scanners.sh"
fi

# =========================================================================
section "LAYER 2  KNOWN VULNS + LEAKED SECRETS  (trivy, osv-scanner, pip-audit)"
# =========================================================================
if have trivy; then
  run "trivy" trivy trivy fs --scanners vuln,secret,misconfig --no-progress --exit-code 1 \
      --skip-dirs node_modules --skip-dirs dist --skip-dirs build \
      --skip-dirs .git --skip-dirs .next --skip-dirs vendor "$TARGET"
else
  skip "trivy" "not installed"
fi

if have osv-scanner; then
  # osv-scanner exit codes: 0=clean, 1=vulnerabilities, 127/128=error or
  # "no package sources found". Only 1 is a real finding — don't cry wolf on a
  # repo osv can't parse. (CLI surface also differs across versions.)
  printf '\n--- osv-scanner ---\n' >>"$LOG"
  if osv-scanner scan --help >/dev/null 2>&1; then osv_cmd="osv-scanner scan -r"; else osv_cmd="osv-scanner -r"; fi
  printf '$ %s %s\n' "$osv_cmd" "$TARGET" >>"$LOG"
  $osv_cmd "$TARGET" >>"$LOG" 2>&1; osv_rc=$?
  case "$osv_rc" in
    0) set_result osv CLEAN;    printf '  %sosv-scanner: clean%s\n' "$c_ok" "$c_off" ;;
    1) set_result osv FINDINGS; printf '  %sosv-scanner: FINDINGS (see log)%s\n' "$c_bad" "$c_off" ;;
    *) set_result osv "SKIP: no parseable manifests / osv error (exit $osv_rc)"
       printf '  %sosv-scanner: no parseable manifests (exit %s)%s\n' "$c_warn" "$osv_rc" "$c_off" ;;
  esac
else
  skip "osv-scanner" "not installed"
fi

if [ "$has_py" = 1 ]; then
  if have pip-audit; then
    REQ="$(find "$TARGET" -maxdepth 3 -name 'requirements*.txt' | head -1)"
    if [ -n "$REQ" ]; then
      run "pip-audit" pipaudit pip-audit -r "$REQ"
    else
      skip "pip-audit" "no requirements.txt found"
    fi
  else
    skip "pip-audit" "not installed"
  fi
fi

# =========================================================================
if [ "$QUICK" = 0 ]; then
section "LAYER 3  INSECURE CODE PATTERNS  (semgrep SAST)"
# =========================================================================
  if have semgrep; then
    # --config auto fetches rules over the network then walks the whole tree;
    # bound it with a timeout and skip vendored/build dirs so it can't stall.
    SEMGREP_TIMEOUT="${SEMGREP_TIMEOUT:-600}"
    printf '\n--- semgrep ---\n' >>"$LOG"
    printf '$ with_timeout %ss semgrep scan --config auto (excluding vendored dirs)\n' "$SEMGREP_TIMEOUT" >>"$LOG"
    with_timeout "$SEMGREP_TIMEOUT" semgrep scan --config auto --error --quiet \
        --exclude node_modules --exclude dist --exclude build --exclude .git \
        --exclude .next --exclude vendor --exclude '*.min.js' --exclude '*.lock' \
        "$TARGET" >>"$LOG" 2>&1
    rc=$?
    case "$rc" in
      0)   set_result semgrep CLEAN;    printf '  %ssemgrep: clean%s\n' "$c_ok" "$c_off" ;;
      124) set_result semgrep "SKIP: timed out after ${SEMGREP_TIMEOUT}s (raise SEMGREP_TIMEOUT=N)"
           printf '  %ssemgrep: TIMEOUT after %ss — partial/none (raise SEMGREP_TIMEOUT)%s\n' "$c_warn" "$SEMGREP_TIMEOUT" "$c_off" ;;
      *)   set_result semgrep FINDINGS; printf '  %ssemgrep: FINDINGS (see log)%s\n' "$c_bad" "$c_off" ;;
    esac
  else
    skip "semgrep" "not installed"
  fi
else
  skip "semgrep" "--quick mode"
fi

# =========================================================================
section "LAYER 4  BEHAVIORAL SUPPLY-CHAIN  (socket, optional)"
# =========================================================================
if have socket; then
  if socket scan create --help >/dev/null 2>&1; then
    run "socket" socket socket scan create --no-interactive "$TARGET"
  else
    skip "socket" "installed but not logged in (run: socket login)"
  fi
else
  skip "socket" "optional - not installed"
fi

# =========================================================================
section "SUMMARY"
# =========================================================================
overall=0
# stable-ish ordering
order=(gd_py gd_js trivy osv pipaudit semgrep socket)
printed=()
print_row() {
  local k="$1" v
  v="$(get_result "$1")"
  [ -z "$v" ] && return
  case "$v" in
    CLEAN)    printf '  %s%-14s clean%s\n' "$c_ok" "$k" "$c_off" ;;
    FINDINGS) printf '  %s%-14s FINDINGS%s\n' "$c_bad" "$k" "$c_off"; overall=1 ;;
    SKIP*)    printf '  %s%-14s %s%s\n' "$c_warn" "$k" "$v" "$c_off" ;;
  esac
}
for k in "${order[@]}"; do print_row "$k"; printed+=("$k"); done
for k in "${RESULT_KEYS[@]}"; do [[ " ${printed[*]} " == *" $k "* ]] || print_row "$k"; done

echo
if [ "$overall" = 0 ]; then
  printf '%sVERDICT: nothing flagged.%s ' "$c_ok" "$c_off"
  echo "(Absence of findings != proof of safety - still review before running.)"
else
  printf '%sVERDICT: findings present - review the log before trusting this code.%s\n' "$c_bad" "$c_off"
fi
echo "Full log: $LOG"
exit "$overall"
